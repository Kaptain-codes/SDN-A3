%% Components of the selected rich client and thin SQLite server.
flowchart TB
  subgraph client["Java Swing client: client/src"]
    screen["DesktopShellFrame + DesktopController<br/>catalogue + planner UI"]
    stores["LocalSessionPlanStore + LocalOutboxRepository<br/>drafts, plans, retry state"]
    sqlite[("SqliteDatabase<br/>shared tables + local-only tables")]
    adapter["HttpRemoteSessionPlanStore<br/>line protocol, batch=10"]
    screen --> stores --> sqlite
    stores --> adapter
  end
  subgraph service["Thin server: server/src/main/java/stemmate/server"]
    http["Server.java<br/>HTTP routing"]
    validator["Validator.java<br/>plan/input checks"]
    db["Database.java<br/>transactions, idempotency,<br/>last-write-wins"]
    schema[("SQLite<br/>shared activities/plans,<br/>device mapping, sync_log")]
    http --> validator --> db --> schema
  end
  adapter <-->|"GET /activities, GET /plans,<br/>POST /sync"| http
  phone["Mobile implementation<br/>not present"] -.->|"QR3 incomplete"| screen
  legacy["prototype/src Role 5 slice"] -.->|"legacy prototype"| client
