%% Selected A4 architecture: rich Swing client + thin SQLite server.
flowchart TB
  subgraph laptop["Laptop: rich client"]
    ui["DesktopShellFrame<br/>Java Swing"]
    local[("Client SQLite<br/>plans, drafts, outbox,<br/>activity cache")]
    adapter["HttpRemoteSessionPlanStore<br/>line protocol, batch 10"]
    ui --> local
    local --> adapter
  end
  subgraph serverhost["Server host"]
    http["Server.java<br/>GET /health, /activities, /plans<br/>POST /sync (max 50)"]
    validate["Validator.java"]
    database["Database.java"]
    sqlite[("SQLite<br/>shared activities/plans,<br/>device map, sync_log")]
    http --> validate --> database --> sqlite
  end
  adapter <-->|"HTTP URL-encoded lines"| http
  legacy["Legacy prototype<br/>prototype/src"] -.-> laptop
  phone["Mobile client<br/>unfinished (QR3)"] -.-> ui
